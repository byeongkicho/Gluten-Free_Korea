{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Grafana Cloud 스택의 기본 Prometheus 데이터소스",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "noglutenkorea.com — Health & SLO",
  "uid": "ngk-health",
  "timezone": "Asia/Seoul",
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "5m",
  "tags": ["ngk", "monitoring"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "가용성 (24h)",
      "description": "매시간 관측한 ngk_http_up의 24시간 평균. 100% = 모든 관측에서 전 엔드포인트 응답.",
      "gridPos": { "h": 6, "w": 5, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(avg_over_time(ngk_http_up[24h])) * 100",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 99 },
              { "color": "green", "value": 99.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "SSL 잔여일",
      "gridPos": { "h": 6, "w": 4, "x": 5, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "refId": "A", "expr": "last_over_time(ngk_ssl_expiry_days[2h])", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "green", "value": 60 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "인스타 데이터 접근 잔여일",
      "description": "음수 = 이미 만료(재인증 필요). 토큰 자체는 무기한(expires_at=0)이라 별도 지표가 없다.",
      "gridPos": { "h": 6, "w": 5, "x": 9, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "refId": "A", "expr": "last_over_time(ngk_instagram_data_access_expiry_days[7d])", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 7 },
              { "color": "green", "value": 14 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "발행 대상 도달",
      "description": "ngk_instagram_api_up — 페이지 토큰으로 실제 IG 계정 조회 성공 여부.",
      "gridPos": { "h": 6, "w": 4, "x": 14, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "refId": "A", "expr": "last_over_time(ngk_instagram_api_up[7d])", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Places",
      "description": "places.json 총 항목 수.",
      "gridPos": { "h": 6, "w": 3, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "refId": "A", "expr": "last_over_time(ngk_places_total[2h])", "instant": true }],
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "에러버짓 잔량 (30d)",
      "description": "SLO 30일 가용성 99.5% 기준 남은 에러버짓. 100% = 아직 한 번도 안 썼다, 0% = 버짓 소진. 버짓 총량은 30일 중 약 3시간 36분. ⚠️ 시간당 수집이라 1시간 미만 장애는 측정에 안 잡힌다 — 근거와 한계는 docs/SLO.md.",
      "gridPos": { "h": 6, "w": 3, "x": 21, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "refId": "A", "expr": "(1 - (1 - avg(avg_over_time(ngk_http_up[30d]))) / 0.005) * 100", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 25 },
              { "color": "green", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "응답 시간 (엔드포인트별)",
      "description": "결측 구간은 관측이 없었던 시간이다 — 0으로 채우지 않는다.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "ngk_http_response_seconds",
          "legendFormat": "{{target}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "spanNulls": false, "drawStyle": "line", "showPoints": "auto", "pointSize": 4 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "체크 실패 · 경고",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "ngk_check_failed", "legendFormat": "failed" },
        { "refId": "B", "expr": "ngk_check_warned", "legendFormat": "warned" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "spanNulls": false, "drawStyle": "bars", "fillOpacity": 60 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "failed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "warned" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "엔드포인트 가용성 추이",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "ngk_http_up", "legendFormat": "{{target}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": { "spanNulls": false, "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["min"] } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "데이터 정합 (누락 필드)",
      "description": "ngk_places_missing — 필드별 누락 항목 수. 0이 정상.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "ngk_places_missing", "legendFormat": "{{field}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "spanNulls": false, "drawStyle": "line", "lineInterpolation": "stepAfter" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] } }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
